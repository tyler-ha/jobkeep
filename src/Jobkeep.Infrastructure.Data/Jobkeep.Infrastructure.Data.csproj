<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===================================================================
       TEMPORARY. This project is scheduled for deletion in Phase 13.3.
       ===================================================================
       It is the pre-split data layer — all 13 entities, one AppDbContext, one
       migration history — quarantined into a single project so that 13.1 could
       move CODE without moving TABLES. Every module references it, which means
       every module can still see every table: the coupling 13.2 and 13.3 exist
       to remove.

       Why the entities are here and not in each module's Domain/ folder, which
       is where they end up: the entity graph has ~11 navigation properties that
       cross a module boundary (JobPosting.AiAnalysis, AtsResult.Resume,
       PostingSkill.Skill, and so on, in both directions). Splitting the classes
       before splitting the foreign keys would mean either circular project
       references or rewriting every projection that traverses one — a behaviour
       change smuggled into a step whose whole value is that it has none.

       So: 13.2 puts every cross-module read behind a contract while the tables
       stay put, and 13.3 splits the entities, the DbContext and the schema
       together. Then this project goes. -->
  <PropertyGroup>
    <RootNamespace>Jobkeep.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Npgsql declares a RANGE on EF Core ([10.0.4, 11.0.0)) while everything
         else here wants the exact 10.0.11 the app is compiled against. Naming
         both EF packages explicitly pins the floor up, so referencing projects
         resolve 10.0.11 too rather than the range's floor — the same CS1705
         trap documented at length in tests/Jobkeep.Tests/Jobkeep.Tests.csproj.
         Bump all three in lockstep. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Jobkeep.SharedKernel/Jobkeep.SharedKernel.csproj" />
    <ProjectReference Include="../Jobkeep.Persistence/Jobkeep.Persistence.csproj" />
  </ItemGroup>

</Project>
