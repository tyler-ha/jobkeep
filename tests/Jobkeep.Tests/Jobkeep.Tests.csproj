<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the app's TFM. Both moved 8.0 -> 10.0 together in Phase 2.6. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- xUnit v3 test projects are executables, not libraries. Required. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 carries its own Microsoft.Testing.Platform runner, so neither
         Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio is needed. The
         `test.runner` section in the repo-root global.json is what points
         `dotnet test` at that runner (see docs/phases/phase-2.2-tests-and-ci.md). -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />

    <!-- Real Postgres in a throwaway container. The whole point of the phase:
         EF InMemory/SQLite silently pass the mapping bugs this project cares
         about (text[], DateOnly, unique indexes, delete behaviour). -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />

    <!-- Truncates all tables between tests so each one starts from a known state. -->
    <PackageReference Include="Respawn" Version="7.0.0" />

    <!-- WebApplicationFactory: boots the real Program.cs in-process. Pinned to the
         installed ASP.NET Core 10 runtime (10.0.11). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />

    <!-- Both pinned to 10.0.11, which is what Jobkeep.dll itself compiles against.
         Phase 2.6 closed the 8.0.10/8.0.11 *major-line* split, but the asymmetry that
         makes these pins necessary survives it: the Npgsql provider declares a floor
         ([10.0.4, 11.0.0)) while EF Design pins an exact 10.0.11, so src resolves to
         10.0.11 and a transitive-only reference here resolves to the floor, 10.0.4.
         Removing these two lines was tried and fails with CS1705 — the test assembly
         would reference EF 10.0.4 while Jobkeep.dll is compiled against 10.0.11.
         Bump these in lockstep with EF Design in src/Jobkeep.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Jobkeep.csproj" />
  </ItemGroup>

</Project>
