{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Left empty here on purpose. A deployed environment supplies the connection
    // string via the ConnectionStrings__Postgres environment variable;
    // appsettings.Development.json fills it for local dev. (Phase 3 is parked and
    // no longer targets RDS — the plan it holds is Neon, which is still just a
    // connection string from here.)
    "Postgres": ""
  },
  // Phase 4 — the job-description analyzer. Bound to AiOptions in
  // Modules/Ai/AiModule.cs.
  //
  // These live in the committed appsettings rather than in a secret store, and
  // that is only acceptable because none of them is a credential: Ollama runs on
  // localhost and has no API key. The moment a hosted provider is used instead,
  // the key does NOT come here — it comes from an environment variable, the same
  // way the connection string does.
  "Ai": {
    "Endpoint": "http://localhost:11434",
    // Pull it first:  ollama pull llama3.2:3b
    "Model": "llama3.2:3b",
    // A 3B model on CPU is slow, and the first request after boot also pays for
    // loading the weights into memory. The default 100s HttpClient timeout is
    // long enough to feel like a hang and short enough to fail that first call.
    "TimeoutSeconds": 180,
    // Job ads get pasted with whole careers pages attached; the useful text is
    // at the top. Truncated rather than rejected — see AnalyzePosting.cs.
    "MaxDescriptionChars": 12000
  },
  // Document import. Bound to DocumentOptions in Modules/Documents/DocumentsModule.cs,
  // which carries the full reasoning for each number — what is here is the value and
  // one line on what it protects.
  //
  // Every value below is EQUAL TO THE C# DEFAULT, and they are meant to stay equal.
  // Writing them down is the point: Program.cs already argues that the upload caps
  // are attached as endpoint metadata rather than as [RequestSizeLimit] attributes
  // *because* MaxBytes is configuration, and a limit nobody can find in a config
  // file is a limit nobody will review. Same "not a credential" reasoning as the Ai
  // section above — these are policy, so committing them is fine.
  //
  // Documents:ParseInBackground is deliberately ABSENT. It is a test seam, not a
  // knob (see its comment in DocumentsModule.cs); listing it here would invite
  // turning it off, which strands every import in Parsing with no way out. It stays
  // reachable only through UseSetting, exactly like Skills:SeedOnStartup.
  "Documents": {
    // 5 MB, as a literal — JSON has no 5 * 1024 * 1024. The hard size cap, checked
    // before anything parses, and the app's first real attack surface: everything
    // downstream costs time proportional to input size, so bounding the input
    // bounds all of it at once.
    "MaxBytes": 5242880,
    // Below this many characters a document counts as having no text — the
    // scanned-PDF case. A pasted ad shorter than this is refused outright
    // (ImportText.cs); a FILE this short is saved and warned about instead.
    "MinTextChars": 40,
    // How much text the model is shown. High enough that it never fires on a real
    // resume — a dense three-page CV is around 8,000 characters.
    "MaxStructureChars": 24000,
    // 64 MB. What a .docx may expand to once unzipped, and the only limit here that
    // exists purely for an attacker: a zip is a compressing format, so MaxBytes
    // bounds what arrives but not what it turns into.
    "MaxDecompressedBytes": 67108864,
    // The review queue is not paged — it is a list of things you have not finished.
    // This is what stops an unbounded query ever being issued.
    "MaxListSize": 200
  }
}
