{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Points at local Postgres in Docker:
    //   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev \
    //     -e POSTGRES_DB=jobkeep postgres:16-alpine
    "Postgres": "Host=localhost;Port=5432;Database=jobkeep;Username=postgres;Password=dev"
  },
  "Cors": {
    // The front end's dev server (Phase 6). Read by Program.cs, which only
    // applies the policy in Development — a deployed environment lists its own
    // origin deliberately rather than inheriting this one.
    //
    // 5173 is Vite's default. If the build tool chosen in step 6.2 serves on a
    // different port, this is the one place that changes.
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
