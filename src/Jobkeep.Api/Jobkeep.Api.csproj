<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The composition root and the only project that knows about HTTP. Holds
       Program.cs, both API surfaces (REST via Endpoints/, GraphQL via GraphQL/),
       the model client, and the config files.

       It is the one project allowed to reference everything — that is what a
       composition root is for. Nothing references it back. -->
  <PropertyGroup>
    <RootNamespace>Jobkeep.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="14.3.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />

    <!-- The concrete model provider, named in exactly one place (ModelClient.cs). -->
    <PackageReference Include="OllamaSharp" Version="5.4.30" />

    <!-- Design-time only, and it lives here rather than in Infrastructure.Data
         because `dotnet ef` resolves the provider and the connection string
         through the STARTUP project. Since 13.1 the command needs both halves
         named — see the Commands section in CLAUDE.md. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Jobkeep.SharedKernel/Jobkeep.SharedKernel.csproj" />
    <ProjectReference Include="../Jobkeep.Contracts/Jobkeep.Contracts.csproj" />
    <ProjectReference Include="../Jobkeep.Infrastructure.Data/Jobkeep.Infrastructure.Data.csproj" />
    <ProjectReference Include="../Jobkeep.Modules.Applications/Jobkeep.Modules.Applications.csproj" />
    <ProjectReference Include="../Jobkeep.Modules.Analytics/Jobkeep.Modules.Analytics.csproj" />
    <ProjectReference Include="../Jobkeep.Modules.Ai/Jobkeep.Modules.Ai.csproj" />
    <ProjectReference Include="../Jobkeep.Modules.Ats/Jobkeep.Modules.Ats.csproj" />
    <ProjectReference Include="../Jobkeep.Modules.Documents/Jobkeep.Modules.Documents.csproj" />
  </ItemGroup>

</Project>
