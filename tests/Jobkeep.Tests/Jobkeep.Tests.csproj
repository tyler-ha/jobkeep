<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches the app's TFM. Both moved 8.0 -> 10.0 together in Phase 2.6. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- xUnit v3 test projects are executables, not libraries. Required. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 carries its own Microsoft.Testing.Platform runner, so neither
         Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio is needed. The
         `test.runner` section in the repo-root global.json is what points
         `dotnet test` at that runner (see docs/phases/phase-2.2-tests-and-ci.md). -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />

    <!-- Real Postgres in a throwaway container. The whole point of the phase:
         EF InMemory/SQLite silently pass the mapping bugs this project cares
         about (text[], DateOnly, unique indexes, delete behaviour). -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />

    <!-- Truncates all tables between tests so each one starts from a known state. -->
    <PackageReference Include="Respawn" Version="7.0.0" />

    <!-- WebApplicationFactory: boots the real Program.cs in-process. Pinned to the
         installed ASP.NET Core 10 runtime (10.0.11). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />

    <!-- Both pinned to 10.0.11, which is what Jobkeep.dll itself compiles against.
         Phase 2.6 closed the 8.0.10/8.0.11 *major-line* split, but the asymmetry that
         makes these pins necessary survives it: the Npgsql provider declares a floor
         ([10.0.4, 11.0.0)) while EF Design pins an exact 10.0.11, so src resolves to
         10.0.11 and a transitive-only reference here resolves to the floor, 10.0.4.
         Removing these two lines was tried and fails with CS1705 — the test assembly
         would reference EF 10.0.4 while Jobkeep.dll is compiled against 10.0.11.
         Bump these in lockstep with EF Design in src/Jobkeep.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 13.1 split src/Jobkeep.csproj into nine. All nine are named here
         rather than relying on Jobkeep.Api pulling them in transitively: the
         suite reaches the app over HTTP, but it also compiles against
         Jobkeep.Models, Jobkeep.Data, Jobkeep.Shared and Jobkeep.Modules.Documents
         directly, and the architecture tests need every module assembly loadable
         by name. An implicit reference that disappears when someone tidies a
         csproj is a confusing failure; a listed one is not. -->
    <ProjectReference Include="../../src/Jobkeep.Api/Jobkeep.Api.csproj" />
    <ProjectReference Include="../../src/Jobkeep.SharedKernel/Jobkeep.SharedKernel.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Contracts/Jobkeep.Contracts.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Infrastructure.Data/Jobkeep.Infrastructure.Data.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Modules.Applications/Jobkeep.Modules.Applications.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Modules.Analytics/Jobkeep.Modules.Analytics.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Modules.Ai/Jobkeep.Modules.Ai.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Modules.Ats/Jobkeep.Modules.Ats.csproj" />
    <ProjectReference Include="../../src/Jobkeep.Modules.Documents/Jobkeep.Modules.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 4.5 fixture documents, copied next to the test assembly so
         ExtractionTests can read them off disk. They are real files — a real PDF
         PdfPig has to parse, a real .docx OpenXml has to open — because the whole
         point of testing extraction is that it runs against bytes rather than
         against a string pretending to be a document. See Fixtures/README.md. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
