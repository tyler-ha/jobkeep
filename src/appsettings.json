{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Left empty here on purpose. A deployed environment supplies the connection
    // string via the ConnectionStrings__Postgres environment variable;
    // appsettings.Development.json fills it for local dev. (Phase 3 is parked and
    // no longer targets RDS — the plan it holds is Neon, which is still just a
    // connection string from here.)
    "Postgres": ""
  },
  // Phase 4 — the job-description analyzer. Bound to AiOptions in
  // Modules/Ai/AiModule.cs.
  //
  // These live in the committed appsettings rather than in a secret store, and
  // that is only acceptable because none of them is a credential: Ollama runs on
  // localhost and has no API key. The moment a hosted provider is used instead,
  // the key does NOT come here — it comes from an environment variable, the same
  // way the connection string does.
  "Ai": {
    "Endpoint": "http://localhost:11434",
    // Pull it first:  ollama pull llama3.2:3b
    "Model": "llama3.2:3b",
    // A 3B model on CPU is slow, and the first request after boot also pays for
    // loading the weights into memory. The default 100s HttpClient timeout is
    // long enough to feel like a hang and short enough to fail that first call.
    "TimeoutSeconds": 180,
    // Job ads get pasted with whole careers pages attached; the useful text is
    // at the top. Truncated rather than rejected — see AnalyzePosting.cs.
    "MaxDescriptionChars": 12000
  }
}
